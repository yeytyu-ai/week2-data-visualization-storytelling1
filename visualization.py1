import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import os

os.makedirs("plots", exist_ok=True)
os.makedirs("output", exist_ok=True)

# Load dataset
df = pd.read_csv("data/beauty_products.csv")

# Display dataset information
print("First 5 rows:")
print(df.head())

print("\nDataset shape:")
print(df.shape)

print("\nMissing values:")
print(df.isnull().sum())

print("\nDuplicate rows:", df.duplicated().sum())

# Save missing values report
df.isnull().sum().to_csv(
    "output/missing_values.csv",
    header=["Missing_Count"]
)

# Save summary statistics
df.describe(include="all").to_csv(
    "output/summary_statistics.csv"
)

# Bar chart: Product categories
if "category" in df.columns:
    df["category"].value_counts().head(10).plot(
        kind="bar", figsize=(9, 5)
    )
    plt.title("Top Beauty Product Categories")
    plt.xlabel("Category")
    plt.ylabel("Product Count")
    plt.tight_layout()
    plt.savefig("plots/category_bar_chart.png")
    plt.close()

# Histogram: Product prices
if "price" in df.columns:
    df["price"] = pd.to_numeric(df["price"], errors="coerce")
    df["price"].dropna().plot(
        kind="hist", bins=20, figsize=(8, 5)
    )
    plt.title("Beauty Product Price Distribution")
    plt.xlabel("Price")
    plt.ylabel("Frequency")
    plt.tight_layout()
    plt.savefig("plots/price_histogram.png")
    plt.close()

# Rating distribution
if "rating" in df.columns:
    df["rating"] = pd.to_numeric(df["rating"], errors="coerce")
    df["rating"].dropna().plot(
        kind="hist", bins=10, figsize=(8, 5)
    )
    plt.title("Beauty Product Rating Distribution")
    plt.xlabel("Rating")
    plt.ylabel("Frequency")
    plt.tight_layout()
    plt.savefig("plots/rating_histogram.png")
    plt.close()

# Correlation heatmap
numeric_data = df.select_dtypes(include="number")

if numeric_data.shape[1] >= 2:
    plt.figure(figsize=(8, 6))
    sns.heatmap(numeric_data.corr(), annot=True, cmap="coolwarm")
    plt.title("Numerical Features Correlation Heatmap")
    plt.tight_layout()
    plt.savefig("plots/correlation_heatmap.png")
    plt.close()

print("\nAnalysis completed successfully!")
